# Copy to .env - NEVER commit real values
AWS_REGION=us-east-1
AWS_PROFILE=default
# Analyzer / notifications
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Lambda remediation safety
DRY_RUN=true
QUARANTINE_SG_ID=sg-xxxxxxxxx
# GuardDuty / Athena
ATHENA_DATABASE=cloudtrail_db
ATHENA_TABLE=cloudtrail_logs
CLOUDTRAIL_S3_BUCKET=your-cloudtrail-bucket
